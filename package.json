{
  "name": "paper-compose",
  "version": "0.8.0",
  "description": "Compose DOCX from Markdown files.",
  "author": "k0ndrateff",
  "keywords": [
    "markdown",
    "docx",
    "compose",
    "gost",
    "text",
    "paper"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "paper-compose": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts test.mdx",
    "start": "node dist/index.js test.mdx",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "mdast": "^3.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "docx": "^9.6.1",
    "image-size": "^2.0.2",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "typograf": "^7.6.0",
    "vm2": "3.10.5",
    "yaml": "2.8.3"
  }
}
